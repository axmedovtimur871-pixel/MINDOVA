# ─── Supabase (Project Settings → API) ─────────────────────────────
# Public values – safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never paste into frontend code.
# Used only for: creating admin accounts and serving a verified PDF to the public.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ─── Site ──────────────────────────────────────────────────────────
# The public address of the website. It is printed inside every QR code
# (https://…/verify/<token>), so set the FINAL domain before issuing real certificates.
NEXT_PUBLIC_SITE_URL=https://zakovat-andijon.uz

# Random string used to hash visitor IPs in verification logs (IPs are never stored).
# Generate one with:  openssl rand -hex 32
VERIFY_LOG_SALT=change-me
